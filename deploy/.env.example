# Copy to .env next to docker-compose.prod.yml on the server.
DOMAIN=orchestrator.example.com
ACME_EMAIL=you@example.com

APP_IMAGE=ghcr.io/aragossa/test-orchestration-platform:latest

POSTGRES_USER=orchestrator
POSTGRES_PASSWORD=change-me
POSTGRES_DB=orchestrator

# Keep empty: docker-compose.prod.yml runs 2 worker replicas, and each one
# then identifies itself by its container hostname. The id is identity, not
# protection: writes are fenced on a per-process lease token, so a shared id
# cannot corrupt runs. It does disable the fast take-back of a worker's own
# runs after a restart (a newcomer never robs a live worker with the same id)
# and merges the replicas in /api/health. Set a stable id only with a single
# worker (replicas: 1).
WORKER_ID=
WORKER_CONCURRENCY=4
WORKER_LEASE_SECONDS=15

# Mock timing (milliseconds). Lower them to make demos faster.
MOCK_PREPARE_DELAY_MS=2000
MOCK_DEPLOY_DELAY_MS=3000
MOCK_READY_DELAY_MS=2000
MOCK_TEST_DELAY_SCALE=1.0
# Probability (0..1) that a mock step fails even with failure_simulation=none.
MOCK_RANDOM_FAILURE_RATE=0
