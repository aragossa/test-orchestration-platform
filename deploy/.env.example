# Copy to .env next to docker-compose.prod.yml on the server.
DOMAIN=orchestrator.example.com
ACME_EMAIL=you@example.com

APP_IMAGE=ghcr.io/aragossa/test-orchestration-platform:latest

POSTGRES_USER=orchestrator
POSTGRES_PASSWORD=change-me
POSTGRES_DB=orchestrator

# A stable id lets a single worker reclaim its own runs immediately after a
# restart. Leave it empty when scaling (`--scale worker=N`): each container
# then uses its hostname and takes over abandoned runs once the lease lapses.
WORKER_ID=vps-worker-1
WORKER_CONCURRENCY=4
WORKER_LEASE_SECONDS=15

# Mock timing (milliseconds). Lower them to make demos faster.
MOCK_PREPARE_DELAY_MS=2000
MOCK_DEPLOY_DELAY_MS=3000
MOCK_READY_DELAY_MS=2000
MOCK_TEST_DELAY_SCALE=1.0
# Probability (0..1) that a mock step fails even with failure_simulation=none.
MOCK_RANDOM_FAILURE_RATE=0
